{
  "profession_rules": {
    "single_profession": true,
    "can_elaborate": true,
    "can_add_details": true,
    "cannot_change": true,
    "examples": {
      "teacher": [
        "English teacher",
        "preschool teacher",
        "high school teacher"
      ],
      "doctor": ["general practitioner", "pediatrician", "nurse"],
